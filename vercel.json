{
  "buildCommand": "export PATH=$HOME/flutter/bin:$PATH && flutter pub get && flutter build web --release",
  "outputDirectory": "build/web",
  "framework": null,
  "installCommand": "S=$HOME/flutter && git clone --depth 1 --branch stable https://github.com/flutter/flutter.git $S && export PATH=$S/bin:$PATH",
  "devCommand": "flutter run -d chrome",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/main.dart.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

