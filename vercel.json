{
  "buildCommand": "bash install.sh && bash build.sh",
  "outputDirectory": "build/web",
  "framework": null,
  "installCommand": "echo 'Installing dependencies...'",
  "devCommand": "flutter run -d chrome",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/main.dart.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

