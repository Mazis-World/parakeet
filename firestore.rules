rules_version = '2';

// Client reads and writes used by the Parakeet app.
// New Firebase projects deny every request until rules like these are published.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function participant() {
      return signedIn() && request.auth.uid in resource.data.participants;
    }

    match /listings/{listingId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid;

      // Hosts edit their own listing. A renter's review only updates the rating.
      allow update: if signedIn() && (
        resource.data.hostId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['rating', 'reviewCount'])
      );

      allow delete: if signedIn()
        && resource.data.hostId == request.auth.uid;
    }

    match /bookings/{bookingId} {
      // Signed-in reads cover the host dashboard, the renter's trips,
      // and the listing calendar (which lists bookings by petListingId).
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.renterId == request.auth.uid
        && request.resource.data.hostId is string
        && request.resource.data.hostId != request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if signedIn() && (
        resource.data.renterId == request.auth.uid
        || resource.data.hostId == request.auth.uid
      );

      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();

      allow create: if signedIn() && (
        request.resource.data.renterId == request.auth.uid
        || request.resource.data.hostId == request.auth.uid
      );

      allow update: if signedIn() && (
        resource.data.renterId == request.auth.uid
        || resource.data.hostId == request.auth.uid
      );

      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /transactions/{transactionId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /conversations/{conversationId} {
      // A missing conversation can be looked up before it is created.
      allow get: if signedIn() && (
        resource == null
        || request.auth.uid in resource.data.participants
      );
      allow list: if participant();

      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;

      allow update: if participant();
      allow delete: if false;

      match /messages/{messageId} {
        function inConversation() {
          return signedIn()
            && request.auth.uid in get(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.participants;
        }

        allow read: if inConversation();
        allow create: if inConversation()
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /users/{userId} {
      allow read: if signedIn();

      allow create: if isOwner(userId)
        || (signedIn() && (
          request.resource.data.keys().hasOnly(['hostStats'])
          || request.resource.data.keys().hasOnly(['renterStats'])
        ));

      allow update: if isOwner(userId)
        || (signedIn() && (
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['hostStats'])
          || request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['renterStats'])
        ));

      allow delete: if isOwner(userId);

      match /favorites/{listingId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        // The other person in a booking or chat creates the notification.
        allow create: if signedIn();
      }
    }
  }
}
